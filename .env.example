# Copy this file to .env and add your key. Never commit the real key.

# Database (relational data + pgvector embeddings). Leave unset to use a local
# SQLite file at backend/locus.db (semantic search then falls back to a plain
# cosine-similarity SQLite index instead of pgvector). Point this at Postgres
# to get pgvector-backed semantic search, locally or on Render — e.g. a local
# Docker Postgres: postgresql://locus:locus@127.0.0.1:5432/locus
LOCUS_DATABASE_URL=

# LLM Provider
LLM_PROVIDER=ollama

OPENAI_API_KEY=
GEMINI_API_KEY=

# OpenAI-compatible gateways (either can be set as LLM_PROVIDER too — they list
# and route to whatever models the gateway itself carries)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
TOKENROUTER_API_KEY=
TOKENROUTER_MODEL=
# OpenCode Go (https://opencode.ai) — the same key works for Zen and Go. Leave
# OPENCODE_MODEL empty to pick a model in Settings from whatever /models returns;
# set OPENCODE_BASE_URL only if your console shows a different endpoint than the
# default https://opencode.ai/zen/go/v1 (e.g. https://opencode.ai/zen/v1 for Zen).
OPENCODE_API_KEY=
OPENCODE_MODEL=
# OPENCODE_BASE_URL=

# Optional Ollama overrides
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_NUM_CTX=32768
OLLAMA_NUM_PREDICT=4096
DEEP_SUMMARY_TEMPERATURE=0.15
CHAT_JOB_MAX_RETRIES=3
CHAT_JOB_RETRY_DELAY_SECONDS=2

# Local semantic retrieval
SEMANTIC_RETRIEVAL_ENABLED=true
VECTOR_FALLBACK_PATH=backend/vector_fallback
EMBEDDING_DIMENSIONS=384
SEMANTIC_CHUNK_CHARS=1200
SEMANTIC_CHUNK_OVERLAP=180
SEMANTIC_TOP_K=6
SEMANTIC_MIN_SCORE=0.18

# Ticket Analysis MVP
TICKET_ANALYSIS_ENABLED=true
TICKET_ANALYSIS_MIN_GROUP_SIZE=3
TICKET_ANALYSIS_MAX_GROUPS=20
TICKET_ANALYSIS_REPRESENTATIVE_TICKETS=3
TICKET_ANALYSIS_USE_EMBEDDINGS=true
TICKET_ANALYSIS_DEDUP_THRESHOLD=0.92
TICKET_ANALYSIS_CLUSTER_SIMILARITY_THRESHOLD=0.78

# Groq (used when LLM_PROVIDER=groq)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TEMPERATURE=0.15
GROQ_MAX_TOKENS=4096
GROQ_CONTEXT_CHAR_BUDGET=12000
GROQ_TIMEOUT_SECONDS=120
GROQ_MAX_RETRIES=2
GROQ_RETRY_BACKOFF_SECONDS=2

# Web research (used by the web_research reasoning mode). Exa (https://exa.ai) is a
# purpose-built search API for LLM-grounding/RAG use cases and returns cleaner, more
# relevant snippets than plain DuckDuckGo. Falls back to DuckDuckGo automatically when
# unset or a call fails — never required.
EXA_API_KEY=

# Sign-in gate (Phase 1: one shared password, not user accounts). Commented out
# because auth is opt-in — set LOCUS_AUTH_PASSWORD to lock a deployment, leave
# it unset for local development.
# LOCUS_AUTH_PASSWORD=
# LOCUS_AUTH_SECRET=            # optional; defaults to a key derived from the password
# LOCUS_AUTH_SESSION_DAYS=30
# LOCUS_ALLOWED_ORIGINS=https://your-frontend.onrender.com

# Post-restart housekeeping: re-extract tabular profiles and index anything unindexed. Runs on
# a background thread so it never delays serving; set to 0 on a memory-tight instance, at the
# cost of files staying unindexed until they are re-uploaded.
# LOCUS_STARTUP_MAINTENANCE=1

# Telegram bridge for Private chats: talk to a phone number from a private chat room.
# This uses your own Telegram account (MTProto), not a bot — a bot cannot message someone
# by phone number. Get the id/hash from https://my.telegram.org, then run
# `python scripts/telegram_login.py` for the session string. All three unset (the default)
# hides the feature. LOCUS_TELEGRAM_SESSION is a credential: never commit it.
# LOCUS_TELEGRAM_API_ID=
# LOCUS_TELEGRAM_API_HASH=
# LOCUS_TELEGRAM_SESSION=

# Secret Images: private photo uploads stored locally to backend/secret_images/
# with automatic compression to 50KB max. Password-gated via LOCUS_AUTH_PASSWORD above.
